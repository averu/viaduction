{
  "name": "viaduction",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code 用の設計駆動開発ハーネス。要件定義書を起点に基本設計・詳細設計・実装タスク・コーディングを支援する。",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "trace": "tsx scripts/validate-traceability.ts",
    "trace:emit": "tsx scripts/validate-traceability.ts --emit",
    "trace:json": "tsx scripts/validate-traceability.ts --json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
